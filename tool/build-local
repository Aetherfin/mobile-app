#!/usr/bin/env bash
# tool/build-local — Local build with secrets + Telegram + smart features.
#
# Wraps tool/build, injecting keystore secrets from .env.secrets
# and sending Telegram notifications on build start/success/fail.
#
# Usage:
#   bash tool/build-local                          # release, split-per-abi
#   bash tool/build-local --quick                  # skip analyze+test+codegen
#   bash tool/build-local --mode debug             # debug, skip signing
#   bash tool/build-local --install                # release + install on device
#   bash tool/build-local --skip-test --skip-analyze  # manual skip
#
# Smart skip: codegen & analyze auto-skip if no relevant files changed.
# Use --no-smart to disable.
#
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
BUILD_ID_FILE="$ROOT/lib/build_id.dart"
SECRETS_FILE="$ROOT/.env.secrets"
CACHE_DIR="$ROOT/.build-cache"
PYTHON="python3"
[ "$(command -v python3 2>/dev/null)" ] || PYTHON="python"

# ---------------------------------------------------------------------------
# Flags
# ---------------------------------------------------------------------------
QUICK=false
NO_SMART=false
EXTRA_ARGS=()

for arg in "$@"; do
  case "$arg" in
    --quick)      QUICK=true; shift ;;
    --no-smart)   NO_SMART=true; shift ;;
    *)            EXTRA_ARGS+=("$arg") ;;
  esac
done
set -- "${EXTRA_ARGS[@]}"

# --quick = skip analyze + test + codegen
if [ "$QUICK" = true ]; then
  set -- --skip-analyze --skip-test --skip-codegen "$@"
fi

# ---------------------------------------------------------------------------
# Restore build_id.dart after build (keeps working tree clean)
# ---------------------------------------------------------------------------
if [ -f "$BUILD_ID_FILE" ]; then
  BUILD_ID_WAS_TRACKED=true
else
  BUILD_ID_WAS_TRACKED=false
fi
trap 'if [ "$BUILD_ID_WAS_TRACKED" = true ]; then git -C "$ROOT" checkout -- lib/build_id.dart 2>/dev/null; else rm -f "$BUILD_ID_FILE"; fi' EXIT

# ---------------------------------------------------------------------------
# Smart skip detection
# ---------------------------------------------------------------------------
mkdir -p "$CACHE_DIR"

smart_skip_codegen() {
  [ "$NO_SMART" = true ] && return 1
  [ ! -f "$CACHE_DIR/last_codegen" ] && return 1
  local db_file="$ROOT/lib/core/local/app_database.dart"
  local marker="$CACHE_DIR/last_codegen"
  [ -f "$db_file" ] && [ "$db_file" -ot "$marker" ] && return 0
  return 1
}

smart_skip_analyze() {
  [ "$NO_SMART" = true ] && return 1
  [ ! -f "$CACHE_DIR/last_analyze" ] && return 1
  local marker="$CACHE_DIR/last_analyze"
  local changed
  changed=$(find "$ROOT/lib" -name "*.dart" -newer "$marker" 2>/dev/null | head -1)
  [ -z "$changed" ] && return 0
  return 1
}

# Track what was smart-skipped
SMART_SKIPPED=""

if ! echo "$@" | grep -qF -- "--skip-codegen"; then
  if smart_skip_codegen; then
    echo "  ⏭ Smart skip: codegen (no schema changes)"
    SMART_SKIPPED+="codegen "
    set -- --skip-codegen "$@"
  fi
fi

if ! echo "$@" | grep -qF -- "--skip-analyze"; then
  if smart_skip_analyze; then
    echo "  ⏭ Smart skip: analyze (no .dart changes)"
    SMART_SKIPPED+="analyze "
    set -- --skip-analyze "$@"
  fi
fi

if [ "$QUICK" = true ]; then
  SMART_SKIPPED+="analyze test codegen (quick) "
fi

# ---------------------------------------------------------------------------
# Load secrets from .env.secrets
# ---------------------------------------------------------------------------
if [ -f "$SECRETS_FILE" ]; then
  echo "  Loading secrets from .env.secrets ..."
  set -a
  # shellcheck disable=SC1090
  source "$SECRETS_FILE"
  set +a
else
  echo "  ⚠ No .env.secrets found — building unsigned, no Telegram." 1>&2
  echo "  Run: bash tool/setup-secrets /path/to/release.jks" 1>&2
fi

# ---------------------------------------------------------------------------
# Telegram env vars (local context)
# ---------------------------------------------------------------------------
HAS_TG=false
if [ -n "${TG_BOT_TOKEN:-}" ] && [ -n "${TG_CHAT_ID:-}" ]; then
  HAS_TG=true
fi

if [ "$HAS_TG" = true ]; then
  BRANCH=$(git -C "$ROOT" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown")
  SHORT_SHA=$(git -C "$ROOT" rev-parse --short HEAD 2>/dev/null || echo "unknown")
  COMMIT_MSG=$(git -C "$ROOT" log -1 --pretty=format:"%s" 2>/dev/null | tr -d '_*`[]' || echo "")
  BUILD_ID="unknown"
  [ -f "$BUILD_ID_FILE" ] && BUILD_ID=$(grep "kBuildId" "$BUILD_ID_FILE" 2>/dev/null | sed "s/.*'\(.*\)'.*/\1/" || echo "unknown")
  TIMESTAMP=$(TZ="Asia/Jakarta" date +"%Y-%m-%d %H:%M WIB")
  MODE="release"
  for i in $(seq 1 $#); do
    eval "arg=\${$i}"
    if [ "$arg" = "--mode" ]; then
      next=$((i + 1))
      eval "MODE=\${$next}"
    fi
  done

  export TG_BRANCH="$BRANCH"
  export TG_SHA="$SHORT_SHA"
  export TG_COMMIT="$COMMIT_MSG"
  export TG_BUILD_ID="$BUILD_ID"
  export TG_MODE="$MODE"
  export TG_ACTOR="$(whoami)@$(hostname)"
  export TG_TIMESTAMP="$TIMESTAMP"
fi

# ---------------------------------------------------------------------------
# Default to release + split-per-abi if no args given
# ---------------------------------------------------------------------------
if [ $# -eq 0 ]; then
  set -- --mode release --split-per-abi --no-universal
fi

# ---------------------------------------------------------------------------
# Notify: Build started
# ---------------------------------------------------------------------------
if [ "$HAS_TG" = true ]; then
  echo ""
  TG_INIT_OUTPUT=$($PYTHON "$ROOT/tool/telegram_notifier.py" init 2>/dev/null || true)
  echo "$TG_INIT_OUTPUT"
  TG_MESSAGE_ID=$(echo "$TG_INIT_OUTPUT" | grep "TG_MESSAGE_ID=" | cut -d= -f2)
  export TG_MESSAGE_ID
fi

# ---------------------------------------------------------------------------
# Clean old APKs
# ---------------------------------------------------------------------------
APK_DIR="$ROOT/build/app/outputs/flutter-apk"
if [ -d "$APK_DIR" ]; then
  OLD_APKS=$(find "$APK_DIR" -name "Aetherfin-v*.apk" 2>/dev/null | wc -l)
  if [ "$OLD_APKS" -gt 0 ]; then
    echo "  Cleaning $OLD_APKS old APK(s) ..."
    rm -f "$APK_DIR"/Aetherfin-v*.apk
  fi
fi

# ---------------------------------------------------------------------------
# Run build with progress tracking + timing
# ---------------------------------------------------------------------------
BUILD_RC=0
BUILD_LOG=$(mktemp)
trap 'rm -f "$BUILD_LOG"' EXIT

tg_update() {
  [ "$HAS_TG" = true ] && [ -n "${TG_MESSAGE_ID:-}" ] || return 0
  export TG_STATUS_TEXT="$1"
  export TG_ICON="${2:-🔨}"
  $PYTHON "$ROOT/tool/telegram_notifier.py" update 2>/dev/null || true
}

progress_bar() {
  local current=$1 total=$2
  local pct=$((current * 100 / total))
  local filled=$((current * 20 / total))
  local empty=$((20 - filled))
  local bar=""
  for ((i=0; i<filled; i++)); do bar+="█"; done
  for ((i=0; i<empty; i++)); do bar+="░"; done
  echo "[$bar] $pct%"
}

# Build steps to track
STEPS=("Install dependencies" "Generate build ID" "Run code generation" "Static analysis" "Unit tests" "Configure signing" "Build universal" "Build per-ABI" "Rename APKs")
STEP_COUNT=${#STEPS[@]}

# Timing
BUILD_START=$(date +%s%N)
STEP_TIMES=()
STEP_NAMES=()
current_step=0
last_step=""
step_start=$BUILD_START

# Run build
set +e
bash "$ROOT/tool/build" --sign "$@" 2>&1 | tee "$BUILD_LOG"
BUILD_RC=${PIPESTATUS[0]}
set -e

BUILD_END=$(date +%s%N)
BUILD_DURATION=$(( (BUILD_END - BUILD_START) / 1000000 ))

# Parse build log for step changes + timing
while IFS= read -r line; do
  for step in "${STEPS[@]}"; do
    if echo "$line" | grep -q "$step"; then
      if [ "$step" != "$last_step" ]; then
        # Record previous step timing
        if [ -n "$last_step" ]; then
          now=$(date +%s%N)
          STEP_TIMES+=($(( (now - step_start) / 1000000 )))
          STEP_NAMES+=("$last_step")
          step_start=$now
        fi
        last_step="$step"
        current_step=$((current_step + 1))
        bar=$(progress_bar "$current_step" "$STEP_COUNT")
        tg_update "$bar $step"
      fi
      break
    fi
  done
done < "$BUILD_LOG"

# Record last step
if [ -n "$last_step" ]; then
  STEP_TIMES+=($(( (BUILD_END - step_start) / 1000000 )))
  STEP_NAMES+=("$last_step")
fi

# ---------------------------------------------------------------------------
# Update smart skip markers
# ---------------------------------------------------------------------------
if [ "$BUILD_RC" -eq 0 ]; then
  touch "$CACHE_DIR/last_codegen" 2>/dev/null || true
  touch "$CACHE_DIR/last_analyze" 2>/dev/null || true
fi

# ---------------------------------------------------------------------------
# Collect APK sizes
# ---------------------------------------------------------------------------
APK_SIZES=""
if [ "$BUILD_RC" -eq 0 ] && [ -d "$APK_DIR" ]; then
  for apk in "$APK_DIR"/Aetherfin-v*.apk; do
    [ -f "$apk" ] || continue
    name=$(basename "$apk")
    size=$(stat -c%s "$apk" 2>/dev/null || stat -f%z "$apk" 2>/dev/null || echo 0)
    size_mb=$(echo "scale=1; $size / 1048576" | bc 2>/dev/null || echo "?")
    APK_SIZES+="  • $name ($size_mb MB)"$'\n'
  done
fi

# ---------------------------------------------------------------------------
# Previous build size comparison
# ---------------------------------------------------------------------------
PREV_SIZES=""
if [ -f "$CACHE_DIR/last_sizes" ]; then
  PREV_SIZES=$(cat "$CACHE_DIR/last_sizes")
fi

# Save current sizes for next comparison
if [ "$BUILD_RC" -eq 0 ] && [ -d "$APK_DIR" ]; then
  > "$CACHE_DIR/last_sizes"
  for apk in "$APK_DIR"/Aetherfin-v*.apk; do
    [ -f "$apk" ] || continue
    name=$(basename "$apk")
    size=$(stat -c%s "$apk" 2>/dev/null || stat -f%z "$apk" 2>/dev/null || echo 0)
    echo "$name=$size" >> "$CACHE_DIR/last_sizes"
  done
fi

# ---------------------------------------------------------------------------
# Notify: Success with detailed summary
# ---------------------------------------------------------------------------
if [ "$HAS_TG" = true ]; then
  if [ "$BUILD_RC" -eq 0 ]; then
    export TG_APK_DIR="$ROOT/build/app/outputs/flutter-apk"
    export TG_BUILD_DURATION="$BUILD_DURATION"
    export TG_SMART_SKIPPED="$SMART_SKIPPED"

    # Build step timing string
    STEP_TIMING=""
    for i in "${!STEP_NAMES[@]}"; do
      mins=$(( ${STEP_TIMES[$i]} / 1000 / 60 ))
      secs=$(( ${STEP_TIMES[$i]} / 1000 % 60 ))
      STEP_TIMING+="  ${STEP_NAMES[$i]}: ${mins}m ${secs}s"$'\n'
    done
    export TG_STEP_TIMING="$STEP_TIMING"
    export TG_APK_SIZES="$APK_SIZES"

    $PYTHON "$ROOT/tool/telegram_notifier.py" success 2>/dev/null || true
  else
    $PYTHON "$ROOT/tool/telegram_notifier.py" fail 2>/dev/null || true
  fi
fi

# ---------------------------------------------------------------------------
# Print summary to terminal
# ---------------------------------------------------------------------------
echo ""
echo "────────────────────────────────────────"
echo "  📊 Build Summary"
echo ""
echo "  Total: $(( BUILD_DURATION / 1000 / 60 ))m $(( BUILD_DURATION / 1000 % 60 ))s"
echo ""
if [ -n "$STEP_TIMING" ]; then
  echo "  Steps:"
  echo "$STEP_TIMING"
fi
if [ -n "$APK_SIZES" ]; then
  echo "  APKs:"
  echo "$APK_SIZES"
fi
if [ -n "$SMART_SKIPPED" ]; then
  echo "  Smart skipped: $SMART_SKIPPED"
fi
echo "────────────────────────────────────────"

exit "$BUILD_RC"
