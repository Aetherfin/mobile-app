#!/usr/bin/env bash
# tool/build-local — Local build with secrets from .env.secrets.
#
# Wraps tool/build, injecting keystore secrets from a local file.
# Secrets file is gitignored — never committed.
#
# Usage:
#   bash tool/build-local                          # release, split-per-abi
#   bash tool/build-local --mode debug             # debug, skip signing
#   bash tool/build-local --install                # release + install on device
#   bash tool/build-local --skip-test --skip-analyze  # fast local build
#
# First time? Create .env.secrets in repo root:
#   KEYSTORE_B64=$(base64 -w0 /path/to/release.jks)
#   STORE_PASSWORD=your_store_password
#   KEY_ALIAS=your_key_alias
#   KEY_PASSWORD=your_key_password
#
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
BUILD_ID_FILE="$ROOT/lib/build_id.dart"
SECRETS_FILE="$ROOT/.env.secrets"

# Restore build_id.dart after build (keeps working tree clean)
if [ -f "$BUILD_ID_FILE" ]; then
  BUILD_ID_WAS_TRACKED=true
else
  BUILD_ID_WAS_TRACKED=false
fi
trap 'if [ "$BUILD_ID_WAS_TRACKED" = true ]; then git -C "$ROOT" checkout -- lib/build_id.dart 2>/dev/null; else rm -f "$BUILD_ID_FILE"; fi' EXIT

# Load secrets from .env.secrets
if [ -f "$SECRETS_FILE" ]; then
  echo "  Loading secrets from .env.secrets ..."
  set -a
  # shellcheck disable=SC1090
  source "$SECRETS_FILE"
  set +a
else
  echo "  ⚠ No .env.secrets found — building unsigned." 1>&2
  echo "  Create $SECRETS_FILE with KEYSTORE_B64, STORE_PASSWORD, KEY_ALIAS, KEY_PASSWORD" 1>&2
fi

# Default to release + split-per-abi if no args given
if [ $# -eq 0 ]; then
  set -- --mode release --split-per-abi --no-universal
fi

exec bash "$ROOT/tool/build" --sign "$@"
