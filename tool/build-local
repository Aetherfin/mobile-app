#!/usr/bin/env bash
# tool/build-local — Local build with secrets + Telegram + smart features.
set -Eeuo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"

# --- Structured Logging ---
log_info()  { echo "  $*"; }
log_warn()  { echo "  ⚠ $*" >&2; }
log_error() { echo "  ✕ $*" >&2; }

# --- Error Trap ---
on_error() {
  log_error "Error on line ${1:-unknown}"
  cleanup
  exit 1
}
trap 'on_error $LINENO' ERR

# --- Cleanup ---
FIFO=""
BUILD_PID=""
TAIL_PID=""
cleanup() {
  [[ -n "${FIFO:-}" ]] && rm -f "$FIFO"
  [[ -n "${TAIL_PID:-}" ]] && kill "$TAIL_PID" 2>/dev/null || true
  if [[ "${BUILD_ID_WAS_TRACKED:-false}" == true ]]; then
    git -C "$ROOT" checkout -- lib/build_id.dart 2>/dev/null || true
  elif [[ -f "$ROOT/lib/build_id.dart" ]]; then
    rm -f "$ROOT/lib/build_id.dart"
  fi
}
trap cleanup EXIT

# --- Dependency Check ---
check_deps() {
  local -a missing=()
  command -v python3 &>/dev/null || missing+=("python3")
  command -v git &>/dev/null || missing+=("git")
  if [[ ${#missing[@]} -gt 0 ]]; then
    log_error "Missing: ${missing[*]}"
    exit 1
  fi
}
check_deps

# --- Constants ---
BUILD_ID_FILE="$ROOT/lib/build_id.dart"
SECRETS_FILE="$ROOT/.env.secrets"
CACHE_DIR="$ROOT/.build-cache"
APK_DIR="$ROOT/build/app/outputs/flutter-apk"
PYTHON="python3"
command -v python3 &>/dev/null || PYTHON="python"

# --- Flags ---
QUICK=false
NO_SMART=false
EXTRA_ARGS=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --quick)     QUICK=true; shift ;;
    --no-smart)  NO_SMART=true; shift ;;
    --)          shift; EXTRA_ARGS+=("$@"); break ;;
    *)           EXTRA_ARGS+=("$1"); shift ;;
  esac
done
if [[ ${#EXTRA_ARGS[@]} -gt 0 ]]; then
  set -- "${EXTRA_ARGS[@]}"
else
  set --
fi

[[ "$QUICK" == true ]] && set -- --skip-analyze --skip-test --skip-codegen "$@"

# --- Build ID tracking ---
BUILD_ID_WAS_TRACKED=false
[[ -f "$BUILD_ID_FILE" ]] && BUILD_ID_WAS_TRACKED=true

# --- Smart skip ---
mkdir -p "$CACHE_DIR"

SMART_SKIPPED=""
if [[ "$NO_SMART" != true ]] && ! echo "$*" | grep -qF -- "--skip-codegen"; then
  if [[ -f "$CACHE_DIR/last_codegen" ]] && [[ -f "$ROOT/lib/core/local/app_database.dart" ]]; then
    if [[ "$ROOT/lib/core/local/app_database.dart" -ot "$CACHE_DIR/last_codegen" ]]; then
      log_info "⏭ Smart skip: codegen (no schema changes)"
      SMART_SKIPPED+="codegen "
      set -- --skip-codegen "$@"
    fi
  fi
fi

if [[ "$NO_SMART" != true ]] && ! echo "$*" | grep -qF -- "--skip-analyze"; then
  if [[ -f "$CACHE_DIR/last_analyze" ]]; then
    if ! find "$ROOT/lib" -name "*.dart" -newer "$CACHE_DIR/last_analyze" 2>/dev/null | head -1 | grep -q .; then
      log_info "⏭ Smart skip: analyze (no .dart changes)"
      SMART_SKIPPED+="analyze "
      set -- --skip-analyze "$@"
    fi
  fi
fi

[[ "$QUICK" == true ]] && SMART_SKIPPED+="analyze test codegen (quick) "

# --- Load secrets ---
if [[ -f "$SECRETS_FILE" ]]; then
  log_info "Loading secrets from .env.secrets ..."
  set -a; # shellcheck disable=SC1090; source "$SECRETS_FILE"; set +a
else
  log_warn "No .env.secrets — unsigned build, no Telegram."
  log_warn "Run: bash tool/setup-secrets /path/to/release.jks"
fi

# --- Telegram env ---
HAS_TG=false
[[ -n "${TG_BOT_TOKEN:-}" && -n "${TG_CHAT_ID:-}" ]] && HAS_TG=true

if [[ "$HAS_TG" == true ]]; then
  export TG_BRANCH
  TG_BRANCH=$(git -C "$ROOT" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown")
  export TG_SHA
  TG_SHA=$(git -C "$ROOT" rev-parse --short HEAD 2>/dev/null || echo "unknown")
  export TG_COMMIT
  TG_COMMIT=$(git -C "$ROOT" log -1 --pretty=format:"%s" 2>/dev/null | tr -d '_*`[]' || echo "")
  export TG_BUILD_ID
  TG_BUILD_ID="unknown"
  [[ -f "$BUILD_ID_FILE" ]] && TG_BUILD_ID=$(grep "kBuildId" "$BUILD_ID_FILE" 2>/dev/null | sed "s/.*'\(.*\)'.*/\1/" || echo "unknown")
  export TG_TIMESTAMP
  TG_TIMESTAMP=$(TZ="Asia/Jakarta" date +"%Y-%m-%d %H:%M WIB")
  export TG_MODE
  TG_MODE="release"
  for i in $(seq 1 $#); do
    eval "arg=\${$i}"
    if [[ "$arg" == "--mode" ]]; then
      next=$((i + 1))
      eval "TG_MODE=\${$next}"
    fi
  done
  export TG_ACTOR
  TG_ACTOR="$(whoami)@$(hostname)"
fi

# --- Default args ---
[[ $# -eq 0 ]] && set -- --mode release --split-per-abi --no-universal

# --- Telegram: build started ---
if [[ "$HAS_TG" == true ]]; then
  echo ""
  TG_INIT_OUTPUT=$("$PYTHON" "$ROOT/tool/telegram_notifier.py" init 2>/dev/null || true)
  echo "$TG_INIT_OUTPUT"
  TG_MESSAGE_ID=$(echo "$TG_INIT_OUTPUT" | grep "TG_MESSAGE_ID=" | cut -d= -f2 || echo "")
  export TG_MESSAGE_ID
fi

# --- Clean old APKs ---
if [[ -d "$APK_DIR" ]]; then
  OLD_COUNT=$(find "$APK_DIR" -name "Aetherfin-v*.apk" 2>/dev/null | wc -l)
  if [[ "$OLD_COUNT" -gt 0 ]]; then
    log_info "Cleaning $OLD_COUNT old APK(s) ..."
    rm -f "$APK_DIR"/Aetherfin-v*.apk
  fi
fi

# --- Build helpers ---
tg_update() {
  [[ "$HAS_TG" == true && -n "${TG_MESSAGE_ID:-}" ]] || return 0
  (
    export TG_STATUS_TEXT="$1"
    export TG_ICON="${2:-🔨}"
    "$PYTHON" "$ROOT/tool/telegram_notifier.py" update 2>/dev/null || true
  ) &
  disown
}

progress_bar() {
  local current=$1 total=$2
  local pct=$((current * 100 / total))
  local filled=$((current * 20 / total))
  local empty=$((20 - filled))
  local bar=""
  for ((i=0; i<filled; i++)); do bar+="█"; done
  for ((i=0; i<empty; i++)); do bar+="░"; done
  echo "[$bar] $pct%"
}

# --- Run build ---
STEPS=("Install dependencies" "Generate build ID" "Run code generation" "Static analysis" "Unit tests" "Configure signing" "Build universal" "Build per-ABI" "Rename APKs")
STEP_COUNT=${#STEPS[@]}
current_step=0
last_step=""
step_start=0

> "$CACHE_DIR/step_times"
FIFO=$(mktemp -u)
mkfifo "$FIFO"

BUILD_START_TS=$(date +%s)
set +e

"$ROOT/tool/build" --sign "$@" > "$FIFO" 2>&1 &
BUILD_PID=$!

while IFS= read -r line; do
  echo "$line"
  for step in "${STEPS[@]}"; do
    if echo "$line" | grep -q "$step"; then
      if [[ "$step" != "$last_step" ]]; then
        if [[ -n "$last_step" ]]; then
          now=$(date +%s)
          echo "$last_step $(( now - step_start ))" >> "$CACHE_DIR/step_times"
          step_start=$now
        fi
        last_step="$step"
        current_step=$((current_step + 1))
        tg_update "$(progress_bar "$current_step" "$STEP_COUNT") $step"
      fi
      break
    fi
  done
done < "$FIFO"

wait "$BUILD_PID"
BUILD_RC=$?
set -e

rm -f "$FIFO"
BUILD_END_TS=$(date +%s)
BUILD_DURATION=$(( (BUILD_END_TS - BUILD_START_TS) * 1000 ))

[[ -n "$last_step" ]] && echo "$last_step $(( BUILD_END_TS - step_start ))" >> "$CACHE_DIR/step_times"

# --- Update smart skip markers ---
if [[ "$BUILD_RC" -eq 0 ]]; then
  touch "$CACHE_DIR/last_codegen" "$CACHE_DIR/last_analyze" 2>/dev/null || true
fi

# --- Collect APK sizes ---
APK_SIZES=""
if [[ "$BUILD_RC" -eq 0 && -d "$APK_DIR" ]]; then
  for apk in "$APK_DIR"/Aetherfin-v*.apk; do
    [[ -f "$apk" ]] || continue
    name=$(basename "$apk")
    size=$(stat -c%s "$apk" 2>/dev/null || stat -f%z "$apk" 2>/dev/null || echo 0)
    size_mb=$(echo "scale=1; $size / 1048576" | bc 2>/dev/null || echo "?")
    APK_SIZES+="  • $name ($size_mb MB)"$'\n'
  done
fi

# --- Save sizes for next comparison ---
if [[ "$BUILD_RC" -eq 0 && -d "$APK_DIR" ]]; then
  : > "$CACHE_DIR/last_sizes"
  for apk in "$APK_DIR"/Aetherfin-v*.apk; do
    [[ -f "$apk" ]] || continue
    echo "$(basename "$apk")=$(stat -c%s "$apk" 2>/dev/null || echo 0)" >> "$CACHE_DIR/last_sizes"
  done
fi

# --- Telegram: success/fail ---
STEP_TIMING=""
if [[ -f "$CACHE_DIR/step_times" ]]; then
  while IFS=' ' read -r sname ssec; do
    STEP_TIMING+="  $sname: $((ssec / 60))m $((ssec % 60))s"$'\n'
  done < "$CACHE_DIR/step_times"
fi

if [[ "$HAS_TG" == true ]]; then
  if [[ "$BUILD_RC" -eq 0 ]]; then
    export TG_APK_DIR="$APK_DIR"
    export TG_BUILD_DURATION="$BUILD_DURATION"
    export TG_SMART_SKIPPED="$SMART_SKIPPED"
    export TG_STEP_TIMING="$STEP_TIMING"
    export TG_APK_SIZES="$APK_SIZES"
    "$PYTHON" "$ROOT/tool/telegram_notifier.py" success 2>/dev/null || true
  else
    "$PYTHON" "$ROOT/tool/telegram_notifier.py" fail 2>/dev/null || true
  fi
fi

# --- Terminal summary ---
echo ""
echo "────────────────────────────────────────"
echo "  📊 Build Summary"
echo ""
echo "  Total: $(( BUILD_DURATION / 1000 / 60 ))m $(( BUILD_DURATION / 1000 % 60 ))s"
[[ -n "$STEP_TIMING" ]] && echo -e "\n  Steps:\n$STEP_TIMING"
[[ -n "$APK_SIZES" ]] && echo -e "\n  APKs:\n$APK_SIZES"
[[ -n "$SMART_SKIPPED" ]] && echo "  Smart skipped: $SMART_SKIPPED"
echo "────────────────────────────────────────"

exit "$BUILD_RC"
