#!/usr/bin/env bash
# tool/setup-secrets — One-time setup: create .env.secrets from existing local files.
#
# Usage:
#   bash tool/setup-secrets /path/to/release.jks
#
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
SECRETS_FILE="$ROOT/.env.secrets"

if [ -f "$SECRETS_FILE" ]; then
  echo "  ⚠ .env.secrets already exists. Remove it first if you want to re-setup."
  exit 1
fi

KEYSTORE_PATH="${1:-}"

if [ -z "$KEYSTORE_PATH" ]; then
  # Try common locations
  for candidate in \
    "$ROOT/android/app/aetherfin-release.jks" \
    "$HOME/.android/debug.keystore"; do
    if [ -f "$candidate" ]; then
      KEYSTORE_PATH="$candidate"
      break
    fi
  done
fi

if [ -z "$KEYSTORE_PATH" ]; then
  echo "  Usage: bash tool/setup-secrets /path/to/release.jks"
  echo ""
  echo "  No keystore found. Pass the path as argument."
  exit 1
fi

if [ ! -f "$KEYSTORE_PATH" ]; then
  echo "  ✕ File not found: $KEYSTORE_PATH"
  exit 1
fi

echo "  Keystore: $KEYSTORE_PATH"
read -rp "  Store password: " STORE_PASSWORD
read -rp "  Key alias: " KEY_ALIAS
read -rp "  Key password: " KEY_PASSWORD

KEYSTORE_B64=$(base64 -w0 "$KEYSTORE_PATH")

cat > "$SECRETS_FILE" <<EOF
KEYSTORE_B64=$KEYSTORE_B64
STORE_PASSWORD=$STORE_PASSWORD
KEY_ALIAS=$KEY_ALIAS
KEY_PASSWORD=$KEY_PASSWORD
EOF

chmod 600 "$SECRETS_FILE"
echo ""
echo "  ✅ Created $SECRETS_FILE ($(wc -c < "$SECRETS_FILE") bytes)"
echo "  File is gitignored and chmod 600."
